{
  "name": "energy-flow-tree-card",
  "version": "0.5.0",
  "description": "Tarjeta Lovelace con el flujo solar (red, batería, solar, casa) y un Sankey de consumos anidados para Home Assistant",
  "type": "module",
  "main": "dist/energy-flow-tree-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
